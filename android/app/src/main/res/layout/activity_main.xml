<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Shows the very JPEG frames sent to the PC, so both screens always match. -->
    <ImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnSwitch"
            style="@style/RoundButton"
            android:contentDescription="@string/switch_camera"
            android:src="@drawable/ic_switch" />

        <ImageButton
            android:id="@+id/btnTorch"
            style="@style/RoundButton"
            android:contentDescription="@string/torch"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/btnMirror"
            style="@style/RoundButton"
            android:contentDescription="@string/mirror"
            android:src="@drawable/ic_flip" />

        <TextView
            android:id="@+id/btnRes"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/resolution"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFps"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/night"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBlack"
            style="@style/RoundButton"
            android:contentDescription="@string/blackout"
            android:src="@drawable/ic_dark" />

        <ImageButton
            android:id="@+id/btnQuit"
            style="@style/RoundButton"
            android:contentDescription="@string/quit"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/zoom"
            android:src="@drawable/ic_zoom" />

        <SeekBar
            android:id="@+id/zoom"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/exposure"
            android:src="@drawable/ic_brightness" />

        <SeekBar
            android:id="@+id/exposure"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/exposureLabel"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/blackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/blackout_hint"
            android:textColor="#40FFFFFF" />
    </FrameLayout>
</FrameLayout>
